-- Novel twin of updatesView, pinned by UpdatesFeedFilterConformanceTest. Favorited novels' chapters that were
-- fetched after the novel was added to the library (date_fetch > favorite_at), i.e. the recent-updates
-- feed. Filters/sorts on date_fetch (not date_upload): many LN sources leave date_upload unknown, so the
-- manga side's dateUpload cutoff would hide them. No scanlator joins (novels offer no scanlator filter).
CREATE VIEW novelUpdatesView AS
SELECT
    novels._id AS novelId,
    novels.title AS novelTitle,
    novel_chapters._id AS chapterId,
    novel_chapters.name AS chapterName,
    novel_chapters.url AS chapterUrl,
    novel_chapters.read,
    novel_chapters.bookmark,
    novel_chapters.last_text_progress AS lastTextProgress,
    novels.source,
    novels.favorite_at IS NOT NULL AS favorite,
    novels.thumbnail_url AS thumbnailUrl,
    novels.cover_last_modified AS coverLastModified,
    novel_chapters.date_fetch AS dateFetch,
    novels.url AS novelUrl
FROM novels JOIN novel_chapters
ON novels._id = novel_chapters.novel_id
WHERE novels.favorite_at IS NOT NULL
AND novel_chapters.date_fetch > novels.favorite_at
-- A series hidden from the library is left out of Updates too, as the manga view leaves it out
AND NOT EXISTS (SELECT 1 FROM library_hidden_novel WHERE library_hidden_novel.novel_id = novels._id)
ORDER BY novel_chapters.date_fetch DESC;

-- Novel twin of updatesView's getRecentUpdatesWithFilters, pinned by UpdatesFeedFilterConformanceTest:
-- read/started/bookmarked, then the include/exclude category blocks with sentinel id 0
-- for uncategorized. "Started" is progress without completion, measured in lastTextProgress rather
-- than pages. Downloaded is not here on either side: download state is on disk, not in the database.
getRecentNovelUpdatesWithFilters:
SELECT *
FROM novelUpdatesView
WHERE dateFetch > :after
AND (:read IS NULL OR read = :read)
AND (
    :started IS NULL
    OR (:started = 1 AND lastTextProgress > 0 AND read = 0)
    OR (:started = 0 AND lastTextProgress = 0 AND read = 0)
)
AND (:bookmarked IS NULL OR bookmark = :bookmarked)
-- With series merging on, a merged series with any hidden member is left out, as the library leaves it out
AND (:seriesMerging = 0 OR NOT EXISTS (
    SELECT 1 FROM merge_group_novel own
    JOIN merge_group_novel member ON member.group_id = own.group_id
    JOIN library_hidden_novel ON library_hidden_novel.novel_id = member.novel_id
    WHERE own.novel_id = novelId
))
AND (
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM novels_categories
        WHERE novels_categories.novel_id = novelId
        AND novels_categories.category_id IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM novels_categories nc WHERE nc.novel_id = novelId)
    )
)
AND (
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM novels_categories
            WHERE novels_categories.novel_id = novelId
            AND novels_categories.category_id IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM novels_categories WHERE novels_categories.novel_id = novelId)
        )
    )
)
ORDER BY dateFetch DESC
LIMIT :limit;
