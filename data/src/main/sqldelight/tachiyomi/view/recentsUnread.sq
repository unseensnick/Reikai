-- Which entries still have something left to read, for the recents surface's "show read" filter.
-- Declares no view or table, so it needs no .sqm: these are queries over the base chapter tables.
--
-- Read from the chapter side rather than from mangas/novels so the partial indexes carry the whole
-- query (chapters_unread_by_manga_index and novel_chapters_unread_by_novel_index are both
-- WHERE read = 0). Scanning the entry tables instead would touch every row in the library to ask a
-- question the index already answers.
--
-- One query per emission, never one per row: RecentsProvider.targetChapter is deliberately resolved
-- per rendered row, and filtering the feed cannot pay that per row on every re-emission.
--
-- Not restricted to favorites. The read lane shows entries that are no longer in the library, and
-- excluding them here would file them as caught up and hide them.

getMangaIdsWithUnread:
SELECT DISTINCT chapters.manga_id AS mangaId
FROM chapters
WHERE chapters.read = 0;

getNovelIdsWithUnread:
SELECT DISTINCT novel_chapters.novel_id AS novelId
FROM novel_chapters
WHERE novel_chapters.read = 0;

-- A write signal per content type, for the recents surface's continue-reading memo: a subscription is
-- told of every write to the tables a query names, so these two exist for their FROM lists, covering
-- the chapter rows a target is read from and the stitch a merged one is resolved over. The caller
-- never runs them, which is why the select is only something valid to name the tables with.
mangaChapterWrites:
SELECT chapters._id
FROM chapters
JOIN merged_chapter_unit ON merged_chapter_unit.chapter_id = chapters._id
LIMIT 1;

novelChapterWrites:
SELECT novel_chapters._id
FROM novel_chapters
JOIN merged_novel_chapter_unit ON merged_novel_chapter_unit.chapter_id = novel_chapters._id
LIMIT 1;
