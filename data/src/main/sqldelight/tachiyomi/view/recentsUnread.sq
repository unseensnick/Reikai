-- Which entries still have something left to read, for the recents "show read" filter. Queries only,
-- so no .sqm. The answer must match what a tap on the row resolves: over the merge group, excluded
-- scanlators left out. A library member of a stitched group answers with its group (unread while any
-- unit has no read copy, from the copies countsByGroup reads); everything else answers with its own
-- chapters (no group, a member outside the library, a group not stitched yet, series merging off).
-- Not restricted to favorites: the read lane shows entries no longer in the library.
-- One query per emission, never per row: RecentsProvider.targetChapter is resolved per rendered row.

-- Runs again on every chapter write, so neither half may read the whole library: a group is unread
-- when one of its unread counted copies has no read copy beside it (mergedUnitCopiesView's
-- readCopies = 0), found by index from the unread chapters, and the unmerged half reads the partial
-- unread index.
getMangaIdsWithUnread:
WITH
judged AS (
    SELECT MGM.manga_id AS mangaId, MGM.group_id AS groupId
    FROM merge_group_manga MGM
    JOIN manga M ON M.id = MGM.manga_id
    WHERE :mergingEnabled AND M.user_favorite_at IS NOT NULL
    AND EXISTS (SELECT 1 FROM mergedCountedUnitView V WHERE V.groupId = MGM.group_id)
),
unreadGroups AS (
    SELECT DISTINCT V.groupId
    FROM mergedCountedUnitView V
    WHERE :mergingEnabled AND V.read = 0
    AND NOT EXISTS (
        SELECT 1 FROM mergedCountedUnitView R WHERE R.groupId = V.groupId AND R.unit = V.unit AND R.read = 1
    )
)
SELECT mangaId FROM judged WHERE groupId IN (SELECT groupId FROM unreadGroups)
UNION
SELECT C.manga_id
FROM chapter C
LEFT JOIN excluded_scanlator ES ON C.manga_id = ES.manga_id AND C.remote_scanlator = ES.scanlator
WHERE C.user_read = 0
AND ES.scanlator IS NULL
AND C.manga_id NOT IN (SELECT mangaId FROM judged);

-- Novel twin. No scanlator join: novels offer no scanlator filter.
getNovelIdsWithUnread:
WITH
judged AS (
    SELECT MGN.novel_id AS novelId, MGN.group_id AS groupId
    FROM merge_group_novel MGN
    JOIN novels N ON N._id = MGN.novel_id
    WHERE :mergingEnabled AND N.favorite_at IS NOT NULL
    AND EXISTS (SELECT 1 FROM mergedNovelCountedUnitView V WHERE V.groupId = MGN.group_id)
),
unreadGroups AS (
    SELECT DISTINCT V.groupId
    FROM mergedNovelCountedUnitView V
    WHERE :mergingEnabled AND V.read = 0
    AND NOT EXISTS (
        SELECT 1 FROM mergedNovelCountedUnitView R WHERE R.groupId = V.groupId AND R.unit = V.unit AND R.read = 1
    )
)
SELECT novelId FROM judged WHERE groupId IN (SELECT groupId FROM unreadGroups)
UNION
SELECT C.novel_id
FROM novel_chapters C
WHERE C.read = 0
AND C.novel_id NOT IN (SELECT novelId FROM judged);

-- A write signal per content type, for the recents surface's continue-reading memo: a subscription is
-- told of every write to the tables a query names, so these two exist for their FROM lists, naming
-- every table a target is resolved from: the chapter rows, the entry row (its chapter sort), the group
-- membership and the stitch a merged one is resolved over, and on manga the excluded scanlators. The
-- caller never runs them, which is why the select is only something valid to name the tables with.
mangaTargetWrites:
SELECT chapter.id
FROM chapter
JOIN manga ON manga.id = chapter.manga_id
JOIN merged_chapter_unit ON merged_chapter_unit.chapter_id = chapter.id
JOIN merge_group_manga ON merge_group_manga.manga_id = manga.id
JOIN excluded_scanlator ON excluded_scanlator.manga_id = manga.id
LIMIT 1;

novelTargetWrites:
SELECT novel_chapters._id
FROM novel_chapters
JOIN novels ON novels._id = novel_chapters.novel_id
JOIN merged_novel_chapter_unit ON merged_novel_chapter_unit.chapter_id = novel_chapters._id
JOIN merge_group_novel ON merge_group_novel.novel_id = novels._id
LIMIT 1;
