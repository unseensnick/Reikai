-- The "newly added to the library" lane of the recents surface, one query per content type.
-- Deliberately over the base tables rather than libraryView / novelLibraryView: those aggregate a
-- chapter count per entry, which a row with no chapter has no use for. The category blocks match
-- updatesView's, sentinel id 0 for uncategorized, so all three lanes filter the same way. No
-- chapter-state filters: a newly-added row has no chapter for unread, started or bookmarked to test.

getRecentlyAddedManga:
SELECT
    manga.id AS mangaId,
    manga.remote_title AS title,
    manga.source_id AS source,
    manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified,
    coalesce(manga.user_favorite_at, 0) AS dateAdded
FROM manga
WHERE manga.user_favorite_at > :after
AND (
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM manga_category
        WHERE manga_category.manga_id = manga.id
        AND COALESCE(manga_category.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM manga_category mc WHERE mc.manga_id = manga.id)
    )
)
AND (
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM manga_category
            WHERE manga_category.manga_id = manga.id
            AND COALESCE(manga_category.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM manga_category WHERE manga_category.manga_id = manga.id)
        )
    )
)
ORDER BY manga.user_favorite_at DESC
LIMIT :limit;

-- Novel twin. An entry out of the library has no favorite_at, so the cutoff keeps it out of the lane;
-- the coalesce only gives the column a non-null type.
getRecentlyAddedNovels:
SELECT
    novels._id AS novelId,
    novels.title,
    novels.source,
    novels.thumbnail_url AS thumbnailUrl,
    novels.cover_last_modified AS coverLastModified,
    coalesce(novels.favorite_at, 0) AS dateAdded
FROM novels
WHERE novels.favorite_at > :after
AND (
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM novels_categories
        WHERE novels_categories.novel_id = novels._id
        AND COALESCE(novels_categories.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM novels_categories nc WHERE nc.novel_id = novels._id)
    )
)
AND (
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM novels_categories
            WHERE novels_categories.novel_id = novels._id
            AND COALESCE(novels_categories.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM novels_categories WHERE novels_categories.novel_id = novels._id)
        )
    )
)
ORDER BY dateAdded DESC
LIMIT :limit;
