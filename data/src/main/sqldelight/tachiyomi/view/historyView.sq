CREATE VIEW historyView AS
SELECT
    history.id AS id,
    manga.id AS mangaId,
    chapter.id AS chapterId,
    manga.remote_title AS title,
    manga.remote_cover AS thumbnailUrl,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_chapter_number AS chapterNumber,
-- RK --> the recents read lane acts on the chapter it names, so the row carries that chapter's own
-- state (read, bookmark, progress) and the four values its download state is looked up by. Upstream
-- selects none of these: its History screen only ever showed a number and a time.
    chapter.remote_name AS chapterName,
    chapter.remote_scanlator AS scanlator,
    chapter.remote_url AS chapterUrl,
    chapter.user_read AS read,
    chapter.user_bookmark AS bookmark,
    chapter.user_last_page_read AS lastPageRead,
    chapter.page_count AS pageCount,
-- RK <--
    history.read_at AS readAt,
    history.read_duration AS readDuration,
    max_read.read_at AS maxReadAt,
    max_read.chapter_id AS maxReadAtChapterId
FROM manga
JOIN chapter
ON manga.id = chapter.manga_id
JOIN history
ON chapter.id = history.chapter_id
JOIN (
    SELECT manga_id, chapter_id, MAX(read_at) AS read_at
    FROM history
    GROUP BY manga_id
) AS max_read
ON chapter.manga_id = max_read.manga_id;

history:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
sourceId,
favorite,
coverLastModified,
chapterNumber,
-- RK: the read lane's chapter state and download-lookup keys, see the view above.
chapterName,
scanlator,
chapterUrl,
read,
bookmark,
lastPageRead,
pageCount,
readAt,
readDuration
FROM historyView
WHERE historyView.readAt > 0
AND maxReadAtChapterId = historyView.chapterId
AND lower(historyView.title) LIKE ('%' || :query || '%')
-- RK --> the recents category filter covers history too, so this carries the same include/exclude
-- blocks as updatesView, sentinel id 0 for uncategorized. Upstream has no filter on this query.
-- Note historyView has no favorite gate, so an entry read but never added to the library has no
-- membership rows and reads as uncategorized: an include set without 0 hides it.
AND (
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM manga_category
        WHERE manga_category.manga_id = mangaId
        AND COALESCE(manga_category.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM manga_category mc WHERE mc.manga_id = mangaId)
    )
)
AND (
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM manga_category
            WHERE manga_category.manga_id = mangaId
            AND COALESCE(manga_category.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM manga_category WHERE manga_category.manga_id = mangaId)
        )
    )
)
-- RK <--
ORDER BY readAt DESC;

getLatestHistory:
SELECT
history.id AS id,
manga.id AS mangaId,
chapter.id AS chapterId,
manga.remote_title AS title,
manga.remote_cover AS thumbnailUrl,
manga.source_id AS sourceId,
manga.user_favorite_at IS NOT NULL AS favorite,
manga.state_cover_last_modified AS coverLastModified,
chapter.remote_chapter_number AS chapterNumber,
-- RK: the read lane's chapter state and download-lookup keys, see the view above.
chapter.remote_name AS chapterName,
chapter.remote_scanlator AS scanlator,
chapter.remote_url AS chapterUrl,
chapter.user_read AS read,
chapter.user_bookmark AS bookmark,
chapter.user_last_page_read AS lastPageRead,
chapter.page_count AS pageCount,
history.read_at AS readAt,
history.read_duration AS readDuration
FROM history
JOIN manga
ON manga.id = history.manga_id
JOIN chapter
ON chapter.id = history.chapter_id
WHERE history.read_at > 0
ORDER BY history.read_at DESC
LIMIT 1;
