-- Novel twin of libraryView, pinned by LibraryViewQueryPlanTest. Favorited novels plus per-novel chapter
-- counts (total, read, latest upload, fetch date, last read, bookmarks) and the concatenated category ids.
-- Both subqueries are prefiltered to favourites, as libraryView's are, so they never aggregate the
-- chapters and categories of a novel outside the library. The download count is not here: downloaded
-- state now comes from NovelDownloadCache (disk), filled in the model. lastRead is derived from
-- novel_history exactly as libraryView derives it from history, so clearing a novel's history drops it
-- in the Last read sort. No excluded_scanlator join: novels offer no scanlator filter.
CREATE VIEW novelLibraryView AS
SELECT
    N.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    -- Read per novel rather than joined to every chapter, as libraryView does; novel_history has no
    -- novel id, so the subquery reaches it through the novel's chapters
    coalesce(
        (
            SELECT max(novel_history.last_read)
            FROM novel_chapters
            JOIN novel_history
            ON novel_history.chapter_id = novel_chapters._id
            WHERE novel_chapters.novel_id = N._id
        ),
        0
    ) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(NC.categories, '0') AS categories
FROM novels N
LEFT JOIN (
    SELECT
        novel_chapters.novel_id,
        count(*) AS total,
        sum(read) AS readCount,
        coalesce(max(novel_chapters.date_upload), 0) AS latestUpload,
        coalesce(max(novel_chapters.date_fetch), 0) AS fetchedAt,
        sum(novel_chapters.bookmark) AS bookmarkCount
    FROM novel_chapters
    WHERE novel_chapters.novel_id IN (SELECT _id FROM novels WHERE favorite_at IS NOT NULL)
    GROUP BY novel_chapters.novel_id
) AS C
ON N._id = C.novel_id
LEFT JOIN (
    SELECT novel_id, group_concat(category_id) AS categories
    FROM novels_categories
    WHERE novel_id IN (SELECT _id FROM novels WHERE favorite_at IS NOT NULL)
    GROUP BY novel_id
) AS NC
ON NC.novel_id = N._id
WHERE N.favorite_at IS NOT NULL;

novelLibrary:
SELECT *
FROM novelLibraryView;
