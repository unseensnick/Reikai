-- rescale Kitsu (sync_id 3) scores to native 2-20 int scale
-- old scores were rescaled from Kitsu's 2-20 down to 1, 1.5, ..., 10 at the API boundary
UPDATE manga_sync
SET score = score * 2
WHERE sync_id = 3;

-- RK: novels bind through the same Kitsu tracker and stored their scores on the same 1-10 scale,
-- so their own table needs the identical rescale or every tracked novel reads at half its rating.
UPDATE novel_tracks
SET score = score * 2
WHERE sync_id = 3;
