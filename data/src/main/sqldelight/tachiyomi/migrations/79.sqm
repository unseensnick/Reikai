-- A kept state's chapter number was written and never read, so both kept-state tables are rebuilt without it
-- (chapter_tombstone.sq), keeping every row. Rebuilt rather than dropped by column, which older Android SQLite
-- lacks. The session tables are untouched.
CREATE TABLE manga_chapter_tombstone_new(
    manga_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    read INTEGER NOT NULL,
    bookmark INTEGER NOT NULL,
    last_page_read INTEGER NOT NULL,
    page_count INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    history_read_at INTEGER,
    history_read_duration INTEGER,
    removed_at INTEGER NOT NULL,
    PRIMARY KEY(manga_id, url),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

INSERT INTO manga_chapter_tombstone_new(
    manga_id, url, read, bookmark, last_page_read, page_count, date_fetch, history_read_at, history_read_duration,
    removed_at
)
SELECT manga_id, url, read, bookmark, last_page_read, page_count, date_fetch, history_read_at, history_read_duration,
    removed_at
FROM manga_chapter_tombstone;

DROP TABLE manga_chapter_tombstone;

ALTER TABLE manga_chapter_tombstone_new RENAME TO manga_chapter_tombstone;

CREATE TABLE novel_chapter_tombstone_new(
    novel_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    read INTEGER NOT NULL,
    bookmark INTEGER NOT NULL,
    last_text_progress INTEGER NOT NULL,
    words INTEGER,
    listened_ms INTEGER,
    date_fetch INTEGER NOT NULL,
    history_last_read INTEGER,
    history_time_read INTEGER,
    removed_at INTEGER NOT NULL,
    PRIMARY KEY(novel_id, url),
    FOREIGN KEY(novel_id) REFERENCES novels (_id)
    ON DELETE CASCADE
);

INSERT INTO novel_chapter_tombstone_new(
    novel_id, url, read, bookmark, last_text_progress, words, listened_ms, date_fetch, history_last_read,
    history_time_read, removed_at
)
SELECT novel_id, url, read, bookmark, last_text_progress, words, listened_ms, date_fetch, history_last_read,
    history_time_read, removed_at
FROM novel_chapter_tombstone;

DROP TABLE novel_chapter_tombstone;

ALTER TABLE novel_chapter_tombstone_new RENAME TO novel_chapter_tombstone;
