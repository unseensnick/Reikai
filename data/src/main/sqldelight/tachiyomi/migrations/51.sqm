-- Novels sharing a source and url are merged into one, and chapters sharing a novel and url likewise, the
-- way 50.sqm merges manga, so both tables can take a unique index on that pair. The tables keep their
-- names and shape, so every child row is re-pointed in place rather than rebuilt; foreign keys are off
-- while this runs, so each child table is handled explicitly and nothing cascades.

-- The copies are ranked with the ones in the library first, then by age. The first one stays, takes each
-- detail it is missing from the first copy that has it, and takes over everything attached to the others.
CREATE TEMP TABLE duplicate_novels AS
SELECT
    _id,
    first_value(_id) OVER (PARTITION BY source, url ORDER BY favorite_at IS NOT NULL DESC, _id ASC) AS keep_id,
    row_number() OVER (PARTITION BY source, url ORDER BY favorite_at IS NOT NULL DESC, _id ASC) AS precedence,
    favorite_at IS NOT NULL AS favorite
FROM novels
WHERE (source, url) IN (
    SELECT source, url
    FROM novels
    GROUP BY source, url
    HAVING count(*) > 1
);

-- Recorded for what lives outside the database under a novel's id, as 50.sqm records manga
INSERT INTO dedupe_merged_ids(content_type, discarded_id, survivor_id)
SELECT 1, _id, keep_id
FROM duplicate_novels
WHERE _id != keep_id;

UPDATE novels
SET favorite_at = merged.favorite_at,
    initialized = merged.initialized,
    artist = merged.artist,
    author = merged.author,
    description = merged.description,
    genre = merged.genre,
    thumbnail_url = merged.thumbnail_url,
    status = merged.status,
    viewer_flags = merged.viewer_flags,
    chapter_flags = merged.chapter_flags,
    notes = merged.notes,
    last_update = merged.last_update,
    cover_last_modified = merged.cover_last_modified
FROM (
    SELECT DISTINCT
        D.keep_id,
        coalesce(
            min(nullif(N.favorite_at, 0)) OVER (PARTITION BY D.keep_id),
            min(N.favorite_at) OVER (PARTITION BY D.keep_id)
        ) AS favorite_at,
        max(N.initialized) OVER (PARTITION BY D.keep_id) AS initialized,
        first_value(N.artist) OVER (PARTITION BY D.keep_id ORDER BY N.artist IS NULL, D.precedence) AS artist,
        first_value(N.author) OVER (PARTITION BY D.keep_id ORDER BY N.author IS NULL, D.precedence) AS author,
        first_value(N.description) OVER (PARTITION BY D.keep_id ORDER BY N.description IS NULL, D.precedence) AS description,
        first_value(N.genre) OVER (PARTITION BY D.keep_id ORDER BY N.genre IS NULL, D.precedence) AS genre,
        first_value(N.thumbnail_url) OVER (PARTITION BY D.keep_id ORDER BY N.thumbnail_url IS NULL, D.precedence) AS thumbnail_url,
        first_value(N.status) OVER (PARTITION BY D.keep_id ORDER BY N.status = 0, D.precedence) AS status,
        first_value(N.viewer_flags) OVER (PARTITION BY D.keep_id ORDER BY N.viewer_flags = 0, D.precedence) AS viewer_flags,
        first_value(N.chapter_flags) OVER (PARTITION BY D.keep_id ORDER BY N.chapter_flags = 0, D.precedence) AS chapter_flags,
        first_value(N.notes) OVER (PARTITION BY D.keep_id ORDER BY N.notes = '', D.precedence) AS notes,
        max(N.last_update) OVER (PARTITION BY D.keep_id) AS last_update,
        max(N.cover_last_modified) OVER (PARTITION BY D.keep_id) AS cover_last_modified
    FROM duplicate_novels D
    JOIN novels N
    ON N._id = D._id
) AS merged
WHERE novels._id = merged.keep_id;

-- Tables allowing one row per novel keep the survivor's own row, else the first copy's by the ranking
DELETE FROM custom_novel_info
WHERE novel_id IN (SELECT _id FROM duplicate_novels)
AND novel_id != (
    SELECT D2._id
    FROM duplicate_novels D
    JOIN duplicate_novels D2
    ON D2.keep_id = D.keep_id
    JOIN custom_novel_info I2
    ON I2.novel_id = D2._id
    WHERE D._id = custom_novel_info.novel_id
    ORDER BY D2.precedence
    LIMIT 1
);

UPDATE custom_novel_info
SET novel_id = (SELECT keep_id FROM duplicate_novels WHERE _id = custom_novel_info.novel_id)
WHERE novel_id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

DELETE FROM novel_update_errors
WHERE novel_id IN (SELECT _id FROM duplicate_novels)
AND novel_id != (
    SELECT D2._id
    FROM duplicate_novels D
    JOIN duplicate_novels D2
    ON D2.keep_id = D.keep_id
    JOIN novel_update_errors UE2
    ON UE2.novel_id = D2._id
    WHERE D._id = novel_update_errors.novel_id
    ORDER BY D2.precedence
    LIMIT 1
);

UPDATE novel_update_errors
SET novel_id = (SELECT keep_id FROM duplicate_novels WHERE _id = novel_update_errors.novel_id)
WHERE novel_id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

-- A track is taken whole, by upstream's manga rule: one on a copy in the library, then the one furthest
-- read, then the one on the copy ranked first, then the oldest.
DELETE FROM novel_tracks
WHERE _id IN (
    SELECT _id
    FROM (
        SELECT
            T._id,
            first_value(T._id) OVER (
                PARTITION BY D.keep_id, T.sync_id
                ORDER BY D.favorite DESC, T.last_chapter_read DESC, D.precedence ASC, T._id ASC
            ) AS keep_track_id
        FROM novel_tracks T
        JOIN duplicate_novels D
        ON D._id = T.novel_id
    )
    WHERE _id != keep_track_id
);

UPDATE novel_tracks
SET novel_id = (SELECT keep_id FROM duplicate_novels WHERE _id = novel_tracks.novel_id)
WHERE novel_id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

-- Categories follow upstream's manga rule: when the novel is in the library, only the copies in it say where
-- it belongs. The pair then collapses, keeping its oldest row.
DELETE FROM novels_categories
WHERE novel_id IN (
    SELECT D._id
    FROM duplicate_novels D
    JOIN novels K
    ON K._id = D.keep_id
    WHERE D.favorite = 0 AND K.favorite_at IS NOT NULL
);

UPDATE novels_categories
SET novel_id = (SELECT keep_id FROM duplicate_novels WHERE _id = novels_categories.novel_id)
WHERE novel_id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

-- A novel belongs to a category once, as a manga does in manga_category. The merge above can bring a
-- pair together, and a pair could already repeat before it, since nothing refused one.
DELETE FROM novels_categories
WHERE _id NOT IN (SELECT min(_id) FROM novels_categories GROUP BY novel_id, category_id);

-- The pair's unique index leads with novel_id, so the index on novel_id alone goes
DROP INDEX idx_novels_categories_novel_id;
CREATE UNIQUE INDEX novels_categories_novel_id_category_id_index ON novels_categories(novel_id, category_id);

-- merge_group_novel: one membership per novel by the rule above, and a group left with fewer than two
-- members goes, with every row that hangs off it.
CREATE TEMP TABLE affected_groups AS
SELECT DISTINCT group_id AS _id
FROM merge_group_novel
WHERE novel_id IN (SELECT _id FROM duplicate_novels);

DELETE FROM merge_group_novel
WHERE novel_id IN (SELECT _id FROM duplicate_novels)
AND novel_id != (
    SELECT D2._id
    FROM duplicate_novels D
    JOIN duplicate_novels D2
    ON D2.keep_id = D.keep_id
    JOIN merge_group_novel G2
    ON G2.novel_id = D2._id
    WHERE D._id = merge_group_novel.novel_id
    ORDER BY D2.precedence
    LIMIT 1
);

UPDATE merge_group_novel
SET novel_id = (SELECT keep_id FROM duplicate_novels WHERE _id = merge_group_novel.novel_id)
WHERE novel_id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

CREATE TEMP TABLE dissolved_groups AS
SELECT _id
FROM affected_groups
WHERE (SELECT count(*) FROM merge_group_novel G WHERE G.group_id = affected_groups._id) < 2;

DELETE FROM merge_group_manga WHERE group_id IN (SELECT _id FROM dissolved_groups);
DELETE FROM merge_group_novel WHERE group_id IN (SELECT _id FROM dissolved_groups);
DELETE FROM merged_chapter_unit WHERE group_id IN (SELECT _id FROM dissolved_groups);
DELETE FROM merged_novel_chapter_unit WHERE group_id IN (SELECT _id FROM dissolved_groups);
DELETE FROM merged_group_ranking WHERE group_id IN (SELECT _id FROM dissolved_groups);
DELETE FROM merge_group WHERE _id IN (SELECT _id FROM dissolved_groups);

-- A surviving group keeps its stitch, which is a cache the reconciliation checks against the chapter rows
-- (see data/merged_chapter_unit.sq). A group whose members changed reads as stale by its ranking stamp,
-- and one that loses a chapter below by its row count, so only the groups this touches restitch.
DROP TABLE dissolved_groups;
DROP TABLE affected_groups;

-- The merged novels brought their chapters with them
UPDATE novel_chapters
SET novel_id = (SELECT keep_id FROM duplicate_novels WHERE _id = novel_chapters.novel_id)
WHERE novel_id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

DELETE FROM novels
WHERE _id IN (SELECT _id FROM duplicate_novels WHERE _id != keep_id);

DROP TABLE duplicate_novels;

-- Chapters sharing a novel and url, whether the merge above brought them together or a source sync stored
-- one twice. The one with reading history is kept, the oldest otherwise, and the read state and history
-- of the others are merged into it, as 50.sqm does for manga chapters.
CREATE TEMP TABLE duplicate_novel_chapters AS
SELECT
    _id,
    first_value(_id) OVER (PARTITION BY novel_id, url ORDER BY has_history DESC, _id ASC) AS keep_id
FROM (
    SELECT
        _id,
        novel_id,
        url,
        EXISTS(SELECT 1 FROM novel_history WHERE novel_history.chapter_id = novel_chapters._id) AS has_history
    FROM novel_chapters
    WHERE (novel_id, url) IN (
        SELECT novel_id, url
        FROM novel_chapters
        GROUP BY novel_id, url
        HAVING count(*) > 1
    )
);

UPDATE novel_chapters
SET read = merged.read,
    bookmark = merged.bookmark,
    last_text_progress = merged.last_text_progress,
    is_downloaded = merged.is_downloaded,
    date_fetch = merged.date_fetch,
    date_upload = merged.date_upload
FROM (
    SELECT
        D.keep_id,
        max(C.read) AS read,
        max(C.bookmark) AS bookmark,
        max(C.last_text_progress) AS last_text_progress,
        max(C.is_downloaded) AS is_downloaded,
        coalesce(min(nullif(C.date_fetch, 0)), 0) AS date_fetch,
        max(C.date_upload) AS date_upload
    FROM duplicate_novel_chapters D
    JOIN novel_chapters C
    ON C._id = D._id
    GROUP BY D.keep_id
) AS merged
WHERE novel_chapters._id = merged.keep_id;

UPDATE novel_history
SET last_read = merged.last_read,
    time_read = merged.time_read
FROM (
    SELECT
        D.keep_id,
        max(H.last_read) AS last_read,
        sum(H.time_read) AS time_read
    FROM duplicate_novel_chapters D
    JOIN novel_history H
    ON H.chapter_id = D._id
    GROUP BY D.keep_id
) AS merged
WHERE novel_history.chapter_id = merged.keep_id;

DELETE FROM novel_history
WHERE chapter_id IN (SELECT _id FROM duplicate_novel_chapters WHERE _id != keep_id);

-- Foreign keys are off, so a discarded chapter's stitch row goes explicitly; its group then holds fewer
-- rows than its ranking recorded, which reads as stale
DELETE FROM merged_novel_chapter_unit
WHERE chapter_id IN (SELECT _id FROM duplicate_novel_chapters WHERE _id != keep_id);

DELETE FROM novel_chapters
WHERE _id IN (SELECT _id FROM duplicate_novel_chapters WHERE _id != keep_id);

DROP TABLE duplicate_novel_chapters;

CREATE UNIQUE INDEX novels_source_url_index ON novels(source, url);

-- The pair's unique index leads with novel_id, so the index on novel_id alone goes
DROP INDEX novel_chapters_novel_id_index;
CREATE UNIQUE INDEX novel_chapters_novel_id_url_index ON novel_chapters(novel_id, url);
