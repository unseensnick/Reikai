-- The reading state of a local chapter a refresh removed, kept until its file comes back
-- (chapter_tombstone.sq), with its sessions beside it. Empty on upgrade.
CREATE TABLE manga_chapter_tombstone(
    manga_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    chapter_number REAL NOT NULL,
    read INTEGER NOT NULL,
    bookmark INTEGER NOT NULL,
    last_page_read INTEGER NOT NULL,
    page_count INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    history_read_at INTEGER,
    history_read_duration INTEGER,
    removed_at INTEGER NOT NULL,
    PRIMARY KEY(manga_id, url),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE TABLE manga_chapter_tombstone_session(
    manga_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    ended_at INTEGER NOT NULL,
    duration INTEGER NOT NULL,
    PRIMARY KEY(manga_id, url, ended_at),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE TABLE novel_chapter_tombstone(
    novel_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    chapter_number REAL NOT NULL,
    read INTEGER NOT NULL,
    bookmark INTEGER NOT NULL,
    last_text_progress INTEGER NOT NULL,
    words INTEGER,
    listened_ms INTEGER,
    date_fetch INTEGER NOT NULL,
    history_last_read INTEGER,
    history_time_read INTEGER,
    removed_at INTEGER NOT NULL,
    PRIMARY KEY(novel_id, url),
    FOREIGN KEY(novel_id) REFERENCES novels (_id)
    ON DELETE CASCADE
);

CREATE TABLE novel_chapter_tombstone_session(
    novel_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    ended_at INTEGER NOT NULL,
    duration INTEGER NOT NULL,
    PRIMARY KEY(novel_id, url, ended_at),
    FOREIGN KEY(novel_id) REFERENCES novels (_id)
    ON DELETE CASCADE
);
