-- The language a local novel's own files name (EPUB dc:language, or details.json over it), keyed by the
-- series path the local novel source stores as its url. The source's own language is a placeholder, so the
-- library, search and Statistics read a local series' language here. Written as the sources' code each time the
-- source reads the series, and carried by the novel's backup, since a restored novel is not read again until
-- a refresh.
CREATE TABLE local_novel_language(
    url TEXT NOT NULL PRIMARY KEY,
    language TEXT NOT NULL
);

setLanguage:
INSERT INTO local_novel_language(url, language)
VALUES (:url, :language)
ON CONFLICT(url) DO UPDATE SET language = excluded.language;

clearLanguage:
DELETE FROM local_novel_language WHERE url = :url;

findAll:
SELECT url, language FROM local_novel_language;

findLanguage:
SELECT language FROM local_novel_language WHERE url = :url;
