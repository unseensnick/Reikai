CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    `order` INTEGER NOT NULL UNIQUE,
    flags INTEGER NOT NULL,
    -- RK: content-type discriminator (0 = universal, 1 = manga, 2 = novel). Manga-created rows default
    -- to 1; novel categories fold in at 2; the system row 0 is universal. Lets one axis serve both types.
    content_type INTEGER NOT NULL DEFAULT 1
);

-- RK: Insert system category (universal: it is the shared uncategorized bucket for both content types)
INSERT OR IGNORE INTO category(id, name, `order`, flags, content_type) VALUES (0, "", -1, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
-- RK: plus content_type
SELECT id, name, `order`, flags, content_type
FROM category
WHERE id = :id;

-- RK: manga category list: manga rows plus universal rows. Novel-only rows (content_type 2) are excluded
-- so the shared table does not leak novel categories into the manga library, backup, or restore paths.
getCategories:
SELECT id, name, `order`, flags, content_type
FROM category
WHERE content_type IN (0, 1)
ORDER BY `order`;

-- RK: every category row, whatever its content type. The edit-categories screen is one list spanning both
-- libraries, so it needs the rows the two per-library reads above exclude from each other, and it is the
-- one place ordering is assigned.
getAllCategories:
SELECT id, name, `order`, flags, content_type
FROM category
ORDER BY `order`;

getCategoriesByMangaId:
-- RK: plus content_type
SELECT C.id, C.name, C.`order`, C.flags, C.content_type
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId
ORDER BY C.`order`;

insert:
-- The position is taken inside the insert, so two categories created at once cannot claim the same one
-- RK: content_type is a parameter, so the create path can name a universal row
INSERT INTO category(name, `order`, flags, content_type)
SELECT :name, coalesce(max(`order`), -1) + 1, :flags, :contentType
FROM category;

delete:
DELETE FROM category
WHERE id = :id;

updateName:
UPDATE category
SET name = :name
WHERE id = :id;

getUserCategoryIds:
SELECT id
FROM category
WHERE id > 0
ORDER BY `order`;

updateOrder:
UPDATE category
SET `order` = :order
WHERE id = :id;

updateFlags:
UPDATE category
SET flags = :flags
WHERE id = :id;

-- RK: clear the per-category sort-override marker (CATEGORY_SORT_CUSTOMIZED, bit 0) on every category
-- so they follow the global sort again, preserving all other bits (sort, hidden). Used by
-- ResetCategoryFlags when "Per-category setting for sort" is turned off. Replaces upstream's updateAllFlags.
clearSortOverrides:
UPDATE category
SET flags = flags & ~1;

-- RK: novel-side reads over the shared table: novel rows plus universal rows (the shared uncategorized
-- system row 0), the novel twin of getCategories.
getNovelCategories:
SELECT id, name, `order`, flags, content_type
FROM category
WHERE content_type IN (0, 2)
ORDER BY `order`;

getNovelCategoriesByNovelId:
SELECT C.id, C.name, C.`order`, C.flags, C.content_type
FROM category C
JOIN novels_categories NC
ON C.id = NC.category_id
WHERE NC.novel_id = :novelId
ORDER BY C.`order`;

selectLastInsertedRowId:
SELECT last_insert_rowid();
