CREATE TABLE mangas_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    FOREIGN KEY(category_id) REFERENCES categories (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

CREATE INDEX idx_mangas_categories_manga_id ON mangas_categories(manga_id);
CREATE INDEX idx_mangas_categories_category_id ON mangas_categories(category_id);

-- RK --> only a category a manga picker can show: universal (0) or manga (1). A novels-only row
-- written here appears in no picker, so nothing could ever remove it. Every writer, restore included,
-- ends here, so it is refused once rather than per caller. The novel insert is its twin, pinned by
-- CategoryLinkGuardTest over both tables.
insert:
INSERT INTO mangas_categories(manga_id, category_id)
SELECT :mangaId, _id FROM categories
WHERE _id = :categoryId AND content_type IN (0, 1);
-- RK <--

deleteMangaCategoryByMangaId:
DELETE FROM mangas_categories
WHERE manga_id = :mangaId;