{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_UNPROTECTED_REPOS": "reikai-claude-memories,Reikai-website"
  },
  "permissions": {
    "additionalDirectories": [
      "E:\\Code\\yokai-y2k\\refs\\komikku",
      "E:\\Code\\yokai-y2k\\refs\\yokai",
      "E:\\Code\\yokai-y2k\\refs\\mihon",
      "E:\\Code\\yokai-y2k\\refs\\mihon-preview",
      "E:\\Code\\yokai-y2k\\refs\\mihon-website",
      "E:\\Code\\yokai-y2k\\refs\\tachiyomi-extension",
      "E:\\Code\\yokai-y2k\\refs\\keiyoushi-extensions",
      "E:\\Code\\yokai-y2k\\refs\\keiyoushi-extensions-source",
      "E:\\Code\\yokai-y2k\\refs\\blueth-yokai",
      "E:\\Code\\yokai-y2k\\refs\\Yōkai-Y2K-New-Icons",
      "E:\\Code\\yokai-y2k\\refs\\lnreader-main",
      "E:\\Code\\yokai-y2k\\refs\\lnreader-2.0.3-Pre-release",
      "E:\\Code\\yokai-y2k\\refs\\lnreader-plugins",
      "E:\\Code\\yokai-y2k\\refs\\tsundoku",
      "E:\\Code\\yokai-y2k\\refs\\IReader",
      "E:\\Code\\yokai-y2k\\refs\\tachiyomisy"
    ],
    "allow": [
      "Bash(./gradlew :domain:test)",
      "Bash(./gradlew clean)",
      "Bash(./gradlew tasks)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git worktree list)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git merge main)",
      "Bash(git stash)",
      "Bash(git stash push *)",
      "Bash(git stash list)",
      "Bash(git stash show *)",
      "Bash(git stash pop)",
      "Bash(git stash apply *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(git status*)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-remote *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(Set-Location *)",
      "Read(E:\\Code\\yokai-y2k\\app\\**)",
      "Read(E:\\Code\\yokai-y2k\\refs\\**)",
      "Grep(E:\\Code\\yokai-y2k\\app\\**)",
      "Grep(E:\\Code\\yokai-y2k\\refs\\**)",
      "Glob(E:\\Code\\yokai-y2k\\app\\**)",
      "Glob(E:\\Code\\yokai-y2k\\refs\\**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/google-services.json)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.jks)",
      "Write(**/*.keystore)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Bash(git checkout -f *)",
      "Bash(git switch -f *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git push --delete *)",
      "Bash(git reflog expire *)",
      "Bash(git gc --prune=now*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push*)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git commit --amend *)",
      "Bash(git filter-branch *)",
      "Bash(adb * uninstall *)",
      "Bash(adb * shell pm clear *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh",
            "timeout": 5000,
            "statusMessage": "Checking file protections..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/warn-large-files.sh",
            "timeout": 5000,
            "statusMessage": "Checking for build artifacts..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.sh",
            "timeout": 5000,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-commands.sh",
            "timeout": 5000,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-save.sh",
            "timeout": 15000,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 5000,
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
