{
  "name": "block a push to main that runs before a cd into the unprotected repo",
  "stdin": {
    "cwd": "@FX@/app",
    "tool_input": {
      "command": "git push origin main && cd ../reikai-claude-memories"
    }
  },
  "env": {
    "CLAUDE_UNPROTECTED_REPOS": "reikai-claude-memories"
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "protected branch 'main'"
  ]
}
