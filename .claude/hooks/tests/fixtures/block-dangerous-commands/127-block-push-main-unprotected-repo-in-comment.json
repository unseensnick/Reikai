{
  "name": "block a push to main that names the unprotected repo in a comment",
  "stdin": {
    "cwd": "@FX@/app",
    "tool_input": {
      "command": "git push origin main # reikai-claude-memories"
    }
  },
  "env": {
    "CLAUDE_UNPROTECTED_REPOS": "reikai-claude-memories"
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "protected branch 'main'"
  ]
}
